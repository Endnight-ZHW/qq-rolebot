# Copy to .env for Compose; fill in your own deployment values.
PUBLIC_HOST=panel.example.com
PUBLIC_BASE_URL=https://panel.example.com
ADMIN_ADDITIONAL_ORIGINS=
PANEL_BIND=127.0.0.1
PANEL_HTTP_PORT=80
PANEL_HTTPS_PORT=443
NAPCAT_NETWORK=napcat
CREATION_RENDER_SOCKET_DIR=/run/qq-rolebot-render
# Optional: otherwise a random first-login password is stored in data/bootstrap-password.txt.
ADMIN_PASSWORD=
ONEBOT_ACCESS_TOKEN=
DEEPSEEK_API_KEY=
# Remote operations read these from the process environment, not automatically from .env.
QQROLEBOT_SSH_HOST=
QQROLEBOT_SSH_PORT=22
QQROLEBOT_SSH_USER=
QQROLEBOT_REMOTE_ROOT=/opt/qq-rolebot
QQROLEBOT_SSH_PASSWORD=
