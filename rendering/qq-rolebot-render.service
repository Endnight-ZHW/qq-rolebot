[Unit]
Description=Rolebot isolated artwork renderer
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/qq-rolebot-render.env
ExecStart=/usr/bin/python3 /opt/qq-rolebot-render/rendering/broker.py --image ${RENDER_IMAGE} --root /var/lib/qq-rolebot-render
ExecStopPost=/usr/bin/python3 /opt/qq-rolebot-render/rendering/broker.py --image ${RENDER_IMAGE} --root /var/lib/qq-rolebot-render --cleanup
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
RuntimeDirectory=qq-rolebot-render
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=qq-rolebot-render
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=512M
MemorySwapMax=0
CPUQuota=100%
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
